[Unit]
Description=Project Strike multiplayer backend
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=strike
Group=strike
WorkingDirectory=/opt/project-strike/current
ExecStart=/usr/bin/node /opt/project-strike/current/server.cjs
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=4180
Environment=LOG_LEVEL=info
Environment=LOG_METRICS_INTERVAL_MS=60000
Environment=ALLOW_INSECURE_ACCOUNTS=true
Restart=always
RestartSec=3
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=project-strike
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=true
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=project-strike
LogNamespace=project-strike

[Install]
WantedBy=multi-user.target
