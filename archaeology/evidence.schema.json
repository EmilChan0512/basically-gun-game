{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "domain", "key", "value", "unit", "evidenceType", "confidence", "source", "notes", "timestamp"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "value": {},
          "unit": { "type": "string" },
          "evidenceType": { "enum": ["EXTRACTED", "OBSERVED", "INFERRED", "TUNED"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "object", "required": ["file", "locator"], "additionalProperties": false, "properties": { "file": { "type": "string", "minLength": 1 }, "locator": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } },
          "notes": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T" }
        }
      }
    }
  }
}
